# Скопируйте в .env и заполните

# --- сеть: сервис слушает только локальный порт, наружу его отдаёт ваш nginx ---
DOMAIN=solver.example.com
# Адрес для пользователей (показывается в /link). Пусто = https://DOMAIN
PUBLIC_URL=
HOST=127.0.0.1
PORT=8080
# адрес nginx, чьему заголовку X-Forwarded-For верим (для лимитов по IP)
TRUSTED_PROXY=127.0.0.1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# api_id и api_hash вашего приложения: https://my.telegram.org -> API development tools (нужны для бота на Telethon)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# MTProto-прокси для бота (необязательно, если Telegram недоступен напрямую). Любая из записей:
#   tg://proxy?server=HOST&port=443&secret=SECRET     https://t.me/proxy?server=...   HOST:443:SECRET
# Секрет — hex (допустим префикс dd). Секреты ee (fake-TLS) Telethon не поддерживает.
TELEGRAM_MTPROXY=
# файл сессии бота (пусто — data/bot.session рядом с базой; хранит адреса пользователей, удалять не нужно)
TELEGRAM_SESSION=
# Telegram id администраторов через запятую (проходят регистрацию всегда)
ADMIN_IDS=
# open — любой; invite — по приглашению (yaklassctl invite create); closed — только добавленные (yaklassctl users add)
REGISTRATION=open

# --- хранилище ---
DB_PATH=data/server.db

# --- лимиты ---
# запусков работ в сутки на пользователя (сколько заданий в работе — неважно)
DAILY_QUOTA=20
# заданий на один запуск работы, больше — отказ
MAX_SOLVES_PER_RUN=150
RATE_PER_MIN=20
MAX_CONCURRENT_SOLVES=4
MAX_AGENTS_PER_USER=3
# рекомендуемая пауза между заданиями (сообщается клиенту)
MIN_TASK_INTERVAL_S=0

# --- общая модель для всех пользователей (OpenAI-совместимый API) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_VISION=true
LLM_JSON_MODE=false

# --- запасная модель (необязательно): включается, если задан LLM_FALLBACK_MODEL ---
# Если основная модель недоступна (сеть, ошибка 5xx, лимит, закончился баланс), запросы идут на запасную.
# Адрес, ключ, vision и JSON-режим по умолчанию такие же, как у основной.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_VISION=
LLM_FALLBACK_JSON_MODE=
# сколько секунд после сбоя основная модель не пробуется
LLM_FALLBACK_COOLDOWN_S=60

# --- поиск (необязательно) ---
SEARXNG_URL=
# always | model | off
SEARCH_MODE=always

# --- безопасность ---
# сервер скачивает картинки заданий только с этих доменов (защита от SSRF)
IMAGE_HOSTS=selcdn.net,yaklass.ru
# true — писать тексты заданий в лог (по умолчанию не пишем)
LOG_TASKS=false
